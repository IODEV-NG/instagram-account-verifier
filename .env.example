# Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit real credentials to version control.

# =============================================================================
# Application
# =============================================================================

# API host binding (default: 0.0.0.0 for containerized deployments)
# APP_HOST=0.0.0.0

# API port (default: 8000)
# APP_PORT=8000

# =============================================================================
# API Authentication
# =============================================================================

# API key for authenticated requests (env-managed, no database required)
# For production: use a secure randomly generated key
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=iv_live_REPLACE_WITH_YOUR_SECURE_KEY

# =============================================================================
# Meta (Instagram) API Configuration
# =============================================================================

# Meta App ID (from developers.facebook.com)
# META_APP_ID=YOUR_APP_ID

# Meta App Secret (NEVER commit this)
# META_APP_SECRET=YOUR_APP_SECRET

# Meta Access Token for Instagram Business Discovery
# Obtain from: https://developers.facebook.com/docs/instagram-api/·
# META_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# Meta API Version (e.g., v19.0)
# META_API_VERSION=v19.0

# Meta Graph API base URL (usually unchanged)
# META_API_BASE_URL=https://graph.facebook.com

# Caller's Instagram professional account ID.
# Required for Business Discovery queries:
#   GET /{caller_ig_user_id}?fields=business_discovery.username({target}){followers_count,media_count}
# Obtain this ID from the Graph API Explorer or from your app's user node.
# META_INSTAGRAM_ACCOUNT_ID=17841405309211844

# =============================================================================
# Rate Limiting
# =============================================================================

# Maximum requests per minute per IP (unauthenticated)
# RATE_LIMIT_PER_MINUTE=100

# Maximum requests per hour per API key (authenticated)
# RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# Redis (Optional - not required for basic operation)
# =============================================================================

# Redis URL for optional caching
# If not set, caching is disabled
# REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 600 = 10 minutes)
# CACHE_TTL_SECONDS=600

# =============================================================================
# Public Web Provider
# =============================================================================

# Enable public web verification fallback
# PUBLIC_WEB_ENABLED=true

# Playwright browser timeout in seconds
# PUBLIC_WEB_TIMEOUT_SECONDS=30

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# =============================================================================
# Security
# =============================================================================

# Enable CORS (set to specific origins in production)
# CORS_ORIGINS=https://yourdomain.com

# =============================================================================
# Proxy Configuration
# =============================================================================

# Trust X-Forwarded-For header from reverse proxy.
# Set to true only when behind a trusted reverse proxy (e.g., nginx, AWS ALB).
# When false, rate limiting uses the direct client IP (safer default).
# TRUST_PROXY_HEADERS=false

# API Key for authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=iv_live_YOUR_SECURE_KEY_HERE

# =============================================================================
# Notes
# =============================================================================
#
# IMPORTANT: Meta's official Instagram API does not provide unrestricted
# lookup or follower-count access for arbitrary personal Instagram accounts.
# Configure Meta credentials only for legitimate business use cases.
#
# Run the application without Redis by leaving REDIS_URL unset.
# Run without Meta by leaving META_* variables unset (Meta provider will
# report as unavailable).
#
# Rate limiting is in-memory and not shared across workers.
# For distributed rate limiting, configure Redis.
#
# Playwright browser must be installed for public-web verification:
#   playwright install chromium
#
# Generate a secure API key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
